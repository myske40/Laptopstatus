<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\laptop-status.ico</ApplicationIcon>
    <AssemblyName>LaptopStatus</AssemblyName>
    <RootNamespace>LaptopStatus</RootNamespace>
    <Company>PT HAHA NASIONAL</Company>
    <Authors>PT HAHA NASIONAL</Authors>
    <Product>Laptop Status</Product>
    <Copyright>Copyright © 2026 PT HAHA NASIONAL</Copyright>
    <Version>2.11.21</Version>
    <AssemblyVersion>2.11.21.0</AssemblyVersion>
    <FileVersion>2.11.21.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Resource Include="Assets\laptop-status-logo.png" />
    <EmbeddedResource Include="Assets\Brand\*.svg" />
    <EmbeddedResource Include="Assets\Brand\Series\*.png" />
    <Content Include="Assets\Sounds\*.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
