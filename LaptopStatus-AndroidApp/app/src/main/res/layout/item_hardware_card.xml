<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_hardware_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/hardwareLogo"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:contentDescription="Logo produsen perangkat"
            android:scaleType="fitCenter"
            android:visibility="invisible" />
        <TextView
            android:id="@+id/hardwareBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Hardware"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/hardwareKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_metric"
            android:text="PROSESOR"
            android:textColor="@color/text_dim"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/hardwareRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Perangkat"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/hardwareModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Model perangkat"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/firstMeterLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Penggunaan" android:textColor="@color/text_dim" android:textSize="10sp" />
            <TextView android:id="@+id/firstMeterValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_main" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/firstMeterBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/line" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="9dp" android:orientation="horizontal">
            <TextView android:id="@+id/secondMeterLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Suhu" android:textColor="@color/text_dim" android:textSize="10sp" />
            <TextView android:id="@+id/secondMeterValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_main" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/secondMeterBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/line" />
    </LinearLayout>
</LinearLayout>
