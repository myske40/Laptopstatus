<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol mengecil halus saat ditekan, kembali dengan pantulan kecil. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="120" android:interpolator="@interpolator/ios_spring" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="120" android:interpolator="@interpolator/ios_spring" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="380" android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="380" android:interpolator="@android:interpolator/overshoot" />
        </set>
    </item>
</selector>
