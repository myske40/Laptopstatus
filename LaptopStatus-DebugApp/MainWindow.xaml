<Window x:Class="LaptopStatus.DebugApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaptopStatus · Debug Console" Height="820" Width="1180" MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="#0B1118" Foreground="{StaticResource TextBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="LaptopStatus Debug Console" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="Uji langsung endpoint LaptopStatus melalui TLS dan pairing aktif." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#17232E" BorderBrush="#2C3D4F" BorderThickness="1" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
        <TextBlock x:Name="ConnectionStatusText" Text="Belum terhubung" Foreground="{StaticResource MutedBrush}"/>
      </Border>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="315"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Koneksi LaptopStatus" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Alamat laptop atau 127.0.0.1 bila aplikasi ini berjalan di laptop yang sama." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <TextBlock Text="Alamat"/><TextBox x:Name="HostInput" Text="127.0.0.1"/>
            <TextBlock Text="Port API"/><TextBox x:Name="PortInput" Text="8765"/>
            <TextBlock Text="Kunci pairing"/><PasswordBox x:Name="PairingKeyInput" Padding="10,8" Margin="0,4,0,10" Background="#101923" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource PanelBorderBrush}"/>
            <TextBlock Text="Fingerprint TLS (SHA-256)"/><TextBox x:Name="FingerprintInput"/>
            <Button x:Name="ConnectButton" Content="Periksa koneksi" Click="Connect_Click" Background="#24443F" Foreground="White"/>
            <Separator Margin="0,8"/>
            <TextBlock Text="Fitur dan endpoint" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
          </StackPanel>
          <ListBox x:Name="PresetList" Background="#101923" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource PanelBorderBrush}" SelectionChanged="PresetList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate><StackPanel Margin="4,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Route}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Permintaan API" FontSize="15" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="MethodInput" SelectedIndex="0" Height="35" VerticalContentAlignment="Center"><ComboBoxItem Content="GET"/><ComboBoxItem Content="POST"/></ComboBox>
            <TextBox x:Name="RouteInput" Grid.Column="1" Text="/api/status" Margin="8,0,0,0"/>
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="Body (JSON untuk endpoint yang memerlukannya)" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="BodyInput" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
          </StackPanel>
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Respons" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="RequestInfoText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="ResponseOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0"/>
          </Grid>
          <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="POST meminta konfirmasi sebelum dikirim. Gunakan parameter yang sesuai untuk endpoint yang dipilih." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Kirim permintaan" Click="Send_Click" Background="#24443F" Foreground="White" MinWidth="150" Margin="12,0,0,0"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
